# Per-exercise long-form records (verification, director reports) live beside
# each brief on the maintainer's machine but are deliberately not committed —
# they are archive weight, not source. See exercises/INDEX.md.
exercises/*/_archive/

# Git worktrees for parallel branches are checked out in here (see AGENTS.md).
# They are whole working copies of the repo — never source. `.claude/launch.json`
# stays tracked, so this ignores the worktree directory only.
.claude/worktrees/

